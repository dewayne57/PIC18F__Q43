		(uuid "0139af0b-145e-45da-8f0a-bfc761db7ef5")
	)
	(text "Port A is rows, input pulled high. Port B is columns, idle low.\nScanning is not performed unless an interrupt on change is generated,\nafter which the rows and columns are scanned.  Columns are scanned \nby making one at a time high (active) and reading the rows.  Scanning \ncontinues as long as any row is low.  "
		(exclude_from_sim no)
		(at 198.882 103.124 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
